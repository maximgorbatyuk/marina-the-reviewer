                  ],
                  "type": "object"
                },
                "type": [
                  "array",
                  "null"
                ]
              },
              "diff": {
                "type": "string"
              },
              "head": {
                "anyOf": [
                  {
                    "additionalProperties": false,
                    "properties": {
                      "commitSha": {
                        "type": "string"
                      },
                      "content": {
                        "type": "string"
                      },
                      "path": {
                        "type": "string"
                      },
                      "revision": {
                        "type": "integer"
                      },
                      "sha256": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "path",
                      "revision",
                      "commitSha",
                      "sha256",
                      "content"
                    ],
                    "type": "object"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "hunks": {
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "lines": {
                      "items": {
                        "type": "string"
                      },
                      "type": [
                        "array",
                        "null"
                      ]
                    },
                    "newCount": {
                      "type": "integer"
                    },
                    "newStart": {
                      "type": "integer"
