                    "oldStart",
                    "oldCount",
                    "newStart",
                    "newCount",
                    "lines"
                  ],
                  "type": "object"
                },
                "type": [
                  "array",
                  "null"
                ]
              },
              "isBinary": {
                "type": "boolean"
              },
              "isLfs": {
                "type": "boolean"
              },
              "isSubmodule": {
                "type": "boolean"
              },
              "newPath": {
                "type": "string"
              },
              "oldPath": {
                "type": "string"
              },
              "operation": {
                "type": "string"
              },
              "skipReason": {
                "type": "string"
              }
