                    "required": [
                      "path",
                      "revision",
                      "commitSha",
                      "sha256",
                      "content"
                    ],
                    "type": "object"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "changedLines": {
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "line": {
                      "type": "integer"
                    },
                    "revision": {
                      "type": "integer"
                    }
                  },
                  "required": [
                    "revision",
