        "protocolSha256": {
          "type": "string"
        },
        "protocolVersion": {
          "type": "integer"
        },
        "responseSchemaSha256": {
          "type": "string"
        },
        "validationPolicyVersion": {
          "type": "integer"
        }
      },
      "required": [
        "baselineCommit",
        "protocolVersion",
        "validationPolicyVersion",
        "responseSchemaSha256",
        "protocolSha256"
      ],
      "type": "object"
    },
    "kind": {
      "type": "string"
    },
    "producer": {
      "additionalProperties": false,
      "properties": {
        "commit": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "version",
        "commit"
      ],
      "type": "object"
    },
    "schemaVersion": {
      "const": 1
